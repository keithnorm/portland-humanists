---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { parseInTimezone } from '../../utils/time';
import siteSettings from '../../content/settings/general.json';
import { attendanceBadges, cleanDescription, initials } from '../../utils/events';

const allEvents = await getCollection('events');
const timezone = siteSettings.timezone ?? 'America/Los_Angeles';

const now = new Date();

const upcomingEvents = allEvents
  .filter(event => event.data.startTime && event.data.endTime && parseInTimezone(event.data.endTime, timezone) > now)
  .sort((a, b) => parseInTimezone(a.data.startTime, timezone).getTime() - parseInTimezone(b.data.startTime, timezone).getTime());

function toDate(v: Date | string): Date {
  return v instanceof Date ? v : new Date(v);
}

function formatTime(v: Date | string, tz: string): string {
  return new Intl.DateTimeFormat('en-US', {
    hour: 'numeric', minute: '2-digit', hour12: true, timeZone: tz,
  }).format(toDate(v));
}

function part(v: Date | string, tz: string, opts: Intl.DateTimeFormatOptions): string {
  return new Intl.DateTimeFormat('en-US', { timeZone: tz, ...opts }).format(toDate(v));
}

function timezoneAbbr(v: Date | string, tz: string): string {
  return new Intl.DateTimeFormat('en-US', { timeZone: tz, timeZoneName: 'short' })
    .formatToParts(toDate(v))
    .find(p => p.type === 'timeZoneName')?.value ?? '';
}
---

<BaseLayout title="Events - Humanists of Greater Portland">
  <!-- Hero -->
  <section class="hgp-cta text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Sunday Programs</h1>
      <p class="text-xl text-[var(--hgp-on-primary)] max-w-2xl">
        Join us every Sunday for engaging presentations on science, reason, ethics, and humanist values.
        Attend in person at Friendly House or join us via Zoom.
      </p>
    </div>
  </section>

  <!-- Subnav -->
  <div class="bg-white border-b border-neutral-200 sticky below-header z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex gap-1 py-2">
        <a href="/events" class="px-4 py-2 rounded-lg text-sm font-medium bg-[var(--hgp-surface)] text-[var(--hgp-primary)]">Upcoming</a>
        <a href="/events/calendar" class="px-4 py-2 rounded-lg text-sm font-medium text-neutral-600 hover:bg-neutral-100 transition-colors">Calendar</a>
        <a href="/events/past" class="px-4 py-2 rounded-lg text-sm font-medium text-neutral-600 hover:bg-neutral-100 transition-colors">Past Programs</a>
      </nav>
    </div>
  </div>

  <!-- Upcoming Events -->
  <section class="py-16 bg-neutral-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-semibold text-neutral-900 mb-8">Upcoming Programs</h2>

      {upcomingEvents.length === 0 ? (
        <div class="bg-white rounded-xl p-8 text-center">
          <p class="text-neutral-600">No upcoming events scheduled at this time. Check back soon!</p>
        </div>
      ) : (
        <div class="space-y-5">
          {upcomingEvents.map((event) => (
            <a
              href={`/events/${event.slug}`}
              class="group block bg-white rounded-2xl ring-1 ring-neutral-200/70 hover:shadow-md hover:ring-[var(--hgp-primary)]/30 transition p-5 md:p-7"
            >
              <div class="flex gap-5 md:gap-7">
                <div class="flex-shrink-0 bg-[var(--hgp-surface)] rounded-xl text-center leading-none px-3 py-3 md:px-4 md:py-4 min-w-[4.25rem] md:min-w-[5.5rem] self-start">
                  <div class="text-[0.7rem] md:text-xs font-semibold uppercase tracking-wide text-[var(--hgp-gold-ink)] mb-1">
                    {part(event.data.startTime, timezone, { weekday: 'short' })} · {part(event.data.startTime, timezone, { month: 'short' })}
                  </div>
                  <div class="font-[family-name:var(--font-display)] text-3xl md:text-4xl font-semibold text-[var(--hgp-primary)]">
                    {part(event.data.startTime, timezone, { day: 'numeric' })}
                  </div>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap gap-2 mb-3">
                    {attendanceBadges(event.data.location, event.data.speakerRemote).map(b => (
                      <span class={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ${b.kind === 'in-person' ? 'bg-[var(--hgp-gold-soft)] text-[var(--hgp-gold-ink)]' : 'bg-[var(--hgp-surface)] text-[var(--hgp-primary)]'}`}>{b.label}</span>
                    ))}
                  </div>
                  <h3 class="text-xl md:text-2xl font-semibold text-neutral-900 leading-snug mb-3 group-hover:text-[var(--hgp-primary)] transition-colors">{event.data.title}</h3>
                  <div class="flex items-center gap-3 mb-3">
                    {event.data.presenterImage ? (
                      <img src={event.data.presenterImage} alt="" class="w-9 h-9 rounded-full object-cover flex-shrink-0" />
                    ) : (
                      <span class="w-9 h-9 rounded-full bg-[var(--hgp-primary)] text-white text-xs font-semibold flex items-center justify-center flex-shrink-0" aria-hidden="true">{initials(event.data.presenter)}</span>
                    )}
                    <div class="min-w-0 text-sm">
                      <div class="font-semibold text-neutral-900">{event.data.presenter}</div>
                      {event.data.presenterTitle && <div class="text-neutral-500 line-clamp-1">{event.data.presenterTitle}</div>}
                    </div>
                  </div>
                  <p class="text-neutral-600 leading-relaxed mb-3">{cleanDescription(event.data.description)}</p>
                  <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
                    <span class="text-neutral-500">{formatTime(event.data.startTime, timezone)} – {formatTime(event.data.endTime, timezone)} {timezoneAbbr(event.data.endTime, timezone)}</span>
                    <span class="inline-flex items-center gap-1.5 font-semibold text-[var(--hgp-primary)] group-hover:gap-2.5 transition-all">
                      Program details
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 hgp-cta text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Never Miss a Program</h2>
      <p class="text-xl text-[var(--hgp-on-primary)] mb-8">
        Join our mailing list to receive weekly reminders and updates about upcoming events.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/join" class="hgp-btn-gold inline-block px-8 py-4 rounded-lg font-bold text-lg transition-colors">
          Join Our Community
        </a>
        <a href="/events/calendar" class="inline-block border-2 border-white text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-white hover:text-[var(--hgp-primary)] transition-colors">
          View Calendar
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
