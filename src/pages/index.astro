---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { HomeVisualEditor } from '../components/HomeVisualEditor';
import client from '../../tina/__generated__/client';
import { parseInTimezone } from '../utils/time';

const allEvents = await getCollection('events');

const tinaResult = await client.queries.homepage({ relativePath: 'home.json' });
const settingsResult = await client.queries.settings({ relativePath: 'general.json' });
const timezone = settingsResult.data.settings.timezone ?? 'America/Los_Angeles';

const now = new Date();

const upcomingEvents = allEvents
  .filter(event => parseInTimezone(event.data.endTime, timezone) > now)
  .sort((a, b) => parseInTimezone(a.data.startTime, timezone).getTime() - parseInTimezone(b.data.startTime, timezone).getTime());

const recentRecordings = allEvents
  .filter(event => parseInTimezone(event.data.endTime, timezone) <= now && (event.data.youtubeId || event.data.vimeoId))
  .sort((a, b) => parseInTimezone(b.data.startTime, timezone).getTime() - parseInTimezone(a.data.startTime, timezone).getTime())
  .slice(0, 3);

// For the "600+ talks since 2008" line over the recordings
const recorded = allEvents.filter(event => event.data.youtubeId || event.data.vimeoId);
const archiveCount = Math.floor(recorded.length / 50) * 50;
const archiveSince = Math.min(...recorded.map(event => parseInTimezone(event.data.startTime, timezone).getFullYear()));
---

<BaseLayout>
  <HomeVisualEditor
    query={tinaResult.query}
    variables={tinaResult.variables}
    data={tinaResult.data}
    upcomingEvents={upcomingEvents}
    recentRecordings={recentRecordings}
    archiveCount={archiveCount}
    archiveSince={archiveSince}
    timezone={timezone}
    client:tina
  />
</BaseLayout>

<script>
  (function () {
    const card = document.getElementById('featured-event-card');
    if (!card) return;

    const rawStart = (card as HTMLElement).dataset.start;
    const rawEnd = (card as HTMLElement).dataset.end;
    if (!rawStart || !rawEnd) return;

    const startMs = new Date(rawStart.replace(' ', 'T')).getTime();
    const endMs = new Date(rawEnd.replace(' ', 'T')).getTime();
    if (isNaN(startMs) || isNaN(endMs)) return;

    const now = Date.now();
    const THIRTY_MIN = 30 * 60 * 1000;

    function enableZoomBtn() {
      const wait = document.getElementById('featured-zoom-wait');
      const btn = document.getElementById('featured-zoom-btn');
      if (wait) wait.style.display = 'none';
      if (btn) btn.style.display = '';
    }

    if (now >= startMs && now <= endMs) {
      const banner = document.getElementById('live-banner-live');
      if (banner) banner.style.display = 'flex';
      enableZoomBtn();
    } else if (now >= startMs - THIRTY_MIN && now < startMs) {
      const banner = document.getElementById('live-banner-soon');
      if (banner) {
        banner.style.display = 'flex';
        const minutesLeft = Math.round((startMs - now) / 60000);
        const textEl = document.getElementById('live-banner-soon-text');
        if (textEl) textEl.textContent = `Starting in ${minutesLeft} minute${minutesLeft !== 1 ? 's' : ''}`;
      }
      enableZoomBtn();
    }
  })();
</script>
